# Optional local profile template. This file is not loaded by Spring Boot.
# Copy to src/main/resources/application-local.properties, replace the placeholders,
# and run with --spring.profiles.active=local. The copied file is ignored by Git.
# Keep real credentials out of this example file.

spring.datasource.url=jdbc:mysql://localhost:3306/subtracker_db?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD

telegram.bot.token=YOUR_TELEGRAM_BOT_TOKEN
telegram.bot.username=YOUR_BOT_USERNAME_WITHOUT_AT_SIGN

# Optional email backup. Use an API key with Transactional email permission,
# and a sender verified in the same Brevo account.
brevo.enabled=false
brevo.api-key=YOUR_BREVO_API_KEY
brevo.sender-email=sender@example.com
brevo.sender-name=Subtracker Bot

# Daily at 09:00 Asia/Colombo. For a local manual check: 0 * * * * *
reminder.cron=0 0 9 * * *
